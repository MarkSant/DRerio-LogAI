msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:487
msgid "Minimum confidence (0-1):"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:491
msgid ""
"🎯 Minimum Confidence (Confidence Threshold)\n"
"\n"
"Filters out detections the model is unsure about.\n"
"\n"
"• HIGH value (0.5-0.9): fewer detections, more precise\n"
"  → Use when: large animals, clear contrast\n"
"  → Downside: may lose fast-moving animals\n"
"\n"
"• LOW value (0.1-0.4): more detections, less precise\n"
"  → Use when: small animals, low contrast\n"
"  → Downside: more false positives (noise)\n"
"\n"
"💡 Recommended default: 0.25"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:505
msgid "NMS (overlap, 0-1):"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:509
msgid ""
"🔲 NMS - Non-Maximum Suppression\n"
"\n"
"Removes duplicate boxes on the same object.\n"
"\n"
"• HIGH value (0.6-0.9): allows more overlap\n"
"  → Use when: animals are very close together\n"
"  → Downside: several detections on the same animal\n"
"\n"
"• LOW value (0.1-0.4): removes overlaps aggressively\n"
"  → Use when: animals are well separated\n"
"  → Downside: may merge nearby animals\n"
"\n"
"💡 Recommended default: 0.45"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:525
msgid "Tracking Parameters (ByteTrack)"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:538
msgid "Use ByteTrack (Recommended)"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:546
msgid ""
"Enables the ByteTrack algorithm for robust tracking with a Kalman filter."
"\n"
"Recommended for most experiments."
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:564
msgid "Track Threshold (0-1):"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:569
msgid ""
"🛤️ Track Threshold\n"
"\n"
"Minimum confidence to START or KEEP a trajectory.\n"
"Low values help keep the trail of animals that are hard to detect.\n"
"\n"
"💡 Default: 0.25"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:578
msgid "Match Threshold (0-1):"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:583
msgid ""
"🔗 Match Threshold\n"
"\n"
"Tolerance when associating boxes.\n"
"HIGH values (close to 1.0) are more permissive for fast movement.\n"
"\n"
"💡 Default: 0.95 (for fast zebrafish)"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:593
msgid "Track Buffer (frames):"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:598
msgid ""
"🧠 Track Buffer\n"
"\n"
"The tracker's memory: how many frames an animal may 'vanish' for before "
"its ID is forgotten.\n"
"\n"
"💡 Default: 90 frames (~3 seconds at 30fps)"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:607
#: src/zebtrack/ui/wizard/model_selection_step.py:757
msgid "Max distance (px):"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:612
msgid ""
"📏 Maximum Centre Distance\n"
"\n"
"The furthest (in pixels) an animal may move between frames and still be "
"considered the same one, when overlap fails.\n"
"\n"
"💡 Default: 200.0 px"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:622
#: src/zebtrack/ui/wizard/model_selection_step.py:758
msgid "IoU Threshold (0-1):"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:627
msgid ""
"🔳 IoU Threshold\n"
"\n"
"Minimum overlap to prefer a box match over a distance match.\n"
"For small, fast fish, low values work better.\n"
"\n"
"💡 Default: 0.1"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:640
msgid ""
"📊 Quick Guide:\n"
"• Track Thresh: ↓ to keep a weak trail\n"
"• Match Thresh: ↑ to accept abrupt movements\n"
"• Buffer: ↑ to 'remember' the fish for longer\n"
"• Distance: ↑ for very fast fish"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:660
msgid "💡 Tip: adjust ONE parameter at a time (±0.05) and test!"
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:675
#, python-brace-format
msgid "Current YOLO defaults: confidence {confidence}, NMS {nms}."
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:691
