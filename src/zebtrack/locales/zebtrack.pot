msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:703
msgid ""
"Restores every threshold to its recommended default value.\n"
"\n"
"Useful if you have made adjustments and want to start over."
msgstr ""

#: src/zebtrack/ui/wizard/model_selection_step.py:711
msgid ""
"Tip: keep the defaults if you are still setting up the videos. You can "
"review these values later in the project settings."
msgstr ""

