# | msgid "Visualizations"
#: src/zebtrack/analysis/reporters/word_reporter.py:653
msgid "Validation Details"
msgstr "Detalhes da validação"

#: src/zebtrack/analysis/reporters/word_reporter.py:657
msgid ""
"The following issues were detected during trajectory validation. These "
"may affect the precision of the calculated metrics."
msgstr ""
"Os problemas a seguir foram detectados durante a validação da trajetória."
" Eles podem afetar a precisão das métricas calculadas."

#: src/zebtrack/analysis/reporters/word_reporter.py:663
msgid ""
"Definitions:\n"
"- Temporal Gaps: Frames where the animal was not detected "
"(occlusion/error).\n"
"- Missing Frames: Total frames skipped if using processing_interval > 1 "
"(expected behavior).\n"
"- Max Gap: The largest consecutive sequence of lost frames."
msgstr ""
"Definições:\n"
"- Lacunas temporais: frames em que o animal não foi detectado "
"(oclusão/erro).\n"
"- Frames ausentes: total de frames pulados ao usar processing_interval > "
"1 (comportamento esperado).\n"
"- Maior lacuna: a maior sequência consecutiva de frames perdidos."

#: src/zebtrack/analysis/reporters/word_reporter.py:675
msgid "No significant issues were detected during trajectory validation."
msgstr ""
"Nenhum problema significativo foi detectado durante a validação da "
"trajetória."

#: src/zebtrack/analysis/reporters/word_reporter.py:678
msgid "Validation details added"
msgstr "Detalhes de validação adicionados"

