#: src/zebtrack/utils/hardware_capability.py:356
msgid ""
"System insufficient for real-time processing. Recommended: record video only"
" and process offline."
msgstr ""
"Sistema insuficiente para processamento em tempo real. Recomendado: apenas "
"gravar vídeo e processar offline."

#: src/zebtrack/utils/hardware_capability.py:362
#, python-brace-format
msgid ""
"Suggested upgrade: at least 2 CPU cores and 4GB of available RAM (current: "
"{cores} cores, {memory:.1f}GB)"
msgstr ""
"Upgrade sugerido: Mínimo 2 cores CPU e 4GB RAM disponível (atual: {cores} "
"cores, {memory:.1f}GB)"

#: src/zebtrack/utils/hardware_capability.py:370
msgid ""
"System limited to 1 aquarium at a time in real time. For multiple aquariums,"
" consider offline recording."
msgstr ""
"Sistema limitado a 1 aquário por vez em tempo real. Para múltiplos aquários,"
" considere gravação offline."

#: src/zebtrack/utils/hardware_capability.py:377
#, python-brace-format
msgid ""
"Limited CPU ({cores} cores). Upgrading to 4+ cores improves multi-aquarium "
"performance."
msgstr ""
"CPU limitada ({cores} cores). Upgrade para 4+ cores melhora desempenho "
"multi-aquário."

#: src/zebtrack/utils/hardware_capability.py:384
#, python-brace-format
msgid ""
"Limited memory ({memory:.1f}GB available). Close background applications or "
"upgrade to 8GB+ RAM."
msgstr ""
"Memória limitada ({memory:.1f}GB disponível). Feche aplicações em segundo "
"plano ou upgrade para 8GB+ RAM."

#: src/zebtrack/utils/hardware_capability.py:390
msgid "System supports up to 2 aquariums simultaneously."
msgstr "Sistema suporta até 2 aquários simultaneamente."

#: src/zebtrack/utils/hardware_capability.py:393
msgid "No GPU detected. Adding a GPU improves performance significantly."
msgstr ""
"GPU não detectada. Adicionar GPU melhora desempenho significativamente."

#: src/zebtrack/utils/hardware_capability.py:398
msgid "System supports 2-3 aquariums simultaneously with good performance."
msgstr "Sistema suporta 2-3 aquários simultaneamente com boa performance."

#: src/zebtrack/utils/hardware_capability.py:403
msgid ""
"Excellent system! Supports 4+ aquariums simultaneously at high performance."
msgstr ""
"Sistema excelente! Suporta 4+ aquários simultaneamente com alta performance."

#: src/zebtrack/utils/hardware_capability.py:410
#, python-brace-format
msgid ""
"CPU under heavy load ({usage:.1f}%). Close background applications before "
"starting capture."
msgstr ""
"CPU com alta carga ({usage:.1f}%). Feche aplicações em segundo plano antes "
"de iniciar captura."

#: src/zebtrack/utils/hardware_capability.py:418
#, python-brace-format
msgid ""
"Memory heavily used ({usage:.1f}%). Close background applications to free "
"RAM."
msgstr ""
"Memória com alta ocupação ({usage:.1f}%). Feche aplicações em segundo plano "
"para liberar RAM."

#: src/zebtrack/utils/hardware_capability.py:441
msgid "⚠️ REAL-TIME PROCESSING NOT RECOMMENDED. Use record-only mode."
msgstr "⚠️ PROCESSAMENTO EM TEMPO REAL NÃO RECOMENDADO. Use modo record-only."

#: src/zebtrack/utils/hardware_capability.py:446
#, python-brace-format
msgid "⚠️ CPU overloaded ({usage:.1f}%). Frames may be dropped."
msgstr "⚠️ CPU sobrecarregada ({usage:.1f}%). Frames podem ser perdidos."

#: src/zebtrack/utils/hardware_capability.py:453
#, python-brace-format
msgid "⚠️ Critical memory ({usage:.1f}%). Risk of system freeze."
msgstr "⚠️ Memória crítica ({usage:.1f}%). Risco de travamento do sistema."

#: src/zebtrack/utils/hardware_capability.py:460
msgid "⚠️ Available memory is very low. Close other applications immediately."
msgstr ""
"⚠️ Memória disponível muito baixa. Feche outras aplicações imediatamente."
