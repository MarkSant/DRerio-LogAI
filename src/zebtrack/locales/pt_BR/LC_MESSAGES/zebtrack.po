msgid "Video File"
msgstr "Arquivo de Vídeo"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:169
msgid "Experimental Configuration"
msgstr "Configuração Experimental"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:183
msgid ""
"Number of Aquariums\n"
"\n"
"Sets whether the video contains 1 or 2 independent tanks.\n"
"• 1: standard analysis.\n"
"• 2: lets you draw two arenas and process them together."
msgstr ""
"Número de Aquários\n"
"\n"
"Define se o vídeo contém 1 ou 2 tanques independentes.\n"
"• 1: Análise padrão.\n"
"• 2: Permite desenhar duas arenas e processá-las em conjunto."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:200
msgid ""
"Animals per Aquarium\n"
"\n"
"How many fish are in each tank.\n"
"• 1: enables the tracker optimized for a single subject.\n"
"• >1: requires Segmentation (seg) mode to avoid ID swaps."
msgstr ""
"Animais por Aquário\n"
"\n"
"Quantidade de peixes em cada tanque.\n"
"• 1: Ativa o rastreador otimizado para sujeito único.\n"
"• >1: Exige o modo de Segmentação (seg) para evitar trocas de ID."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:217
msgid ""
"Real Width (cm)\n"
"\n"
"Horizontal size of the tank in centimetres.\n"
"• Essential to compute speed in cm/s and total distance."
msgstr ""
"Largura Real (cm)\n"
"\n"
"Dimensão horizontal do tanque em centímetros.\n"
"• Essencial para calcular velocidade em cm/s e distância total."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:232
msgid ""
"Real Height (cm)\n"
"\n"
"Vertical size of the tank in centimetres."
msgstr ""
"Altura Real (cm)\n"
"\n"
"Dimensão vertical do tanque em centímetros."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:239
msgid "Behaviour Metrics"
msgstr "Métricas de Comportamento"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:247
msgid "Sharp turn (degrees/s):"
msgstr "Curva Acentuada (graus/s):"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:253
msgid ""
"Sharp Turn Threshold\n"
"\n"
"Minimum angular speed for an abrupt change of direction to count.\n"
"• Raise it: makes turn detection stricter.\n"
"• Default: 180.0 degrees/s."
msgstr ""
"Limiar de Curva Acentuada (Sharp Turn)\n"
"\n"
"Velocidade angular mínima para contar uma mudança de direção brusca.\n"
"• Aumentar: Torna a detecção de curvas mais restritiva.\n"
"• Padrão: 180.0 graus/s."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:264
msgid "Freezing (cm/s):"
msgstr "Congelamento (cm/s):"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:270
msgid ""
"Freezing Threshold (Speed)\n"
"\n"
"Speed below which the fish is considered motionless.\n"
"• Lower it: if small breathing movements are counting as swimming.\n"
"• Default: 0.5 cm/s."
msgstr ""
"Limiar de Congelamento (Velocidade)\n"
"\n"
"Velocidade abaixo da qual o peixe é considerado imóvel.\n"
"• Diminuir: Se pequenos movimentos de respiração estiverem contando como nado.\n"
"• Padrão: 0.5 cm/s."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:281
msgid "Min. duration (s):"
msgstr "Duração Mín. (s):"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:287
msgid ""
"Minimum Freezing Duration\n"
"\n"
"How long the fish must stay still for the event to be recorded.\n"
"• E.g. 1.0s means brief pauses (<1s) are ignored."
msgstr ""
"Duração Mínima de Congelamento\n"
"\n"
"Tempo mínimo que o peixe deve ficar parado para registrar o evento.\n"
"• Ex: 1.0s significa que paradas rápidas (<1s) serão ignoradas."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:299
msgid "Trajectory Smoothing"
msgstr "Suavização de Trajetória"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:307
msgid "Smoothing window:"
msgstr "Janela Suavização:"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:313
msgid ""
"Smoothing Window (frames)\n"
"\n"
"Number of frames for the moving average. MUST BE ODD.\n"
"• Raise it: removes jitter, but over-smooths corners.\n"
"• Default: 5 (Express) or 7 (Full)."
msgstr ""
"Janela de Suavização (frames)\n"
"\n"
"Número de frames para média móvel. DEVE SER ÍMPAR.\n"
"• Aumentar: Remove tremidos, mas suaviza demais os cantos.\n"
"• Padrão: 5 (Express) ou 7 (Completo)."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:324
msgid "Polynomial order:"
msgstr "Ordem Polinômio:"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:330
msgid ""
"Polynomial Order\n"
"\n"
"Complexity of the curve fit. Must be SMALLER than the window.\n"
"• Default: 2."
msgstr ""
"Ordem do Polinômio\n"
"\n"
"Complexidade do ajuste de curva. Deve ser MENOR que a janela.\n"
"• Padrão: 2."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:342
msgid "ℹ️ Removes jitter without erasing real movement."
msgstr "ℹ️ Remove tremidos sem apagar movimentos reais."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:348
msgid "Processing Optimization"
msgstr "Otimização de Processamento"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:362
msgid ""
"Analysis Interval (frames)\n"
"\n"
"Processes 1 frame out of every N frames of the video.\n"
"• 1: analyzes everything (slow).\n"
"• 10: skips 9 frames (fast).\n"
"• Recommended: 5 or 10 depending on the video speed."
msgstr ""
"Intervalo de Análise (frames)\n"
"\n"
"Processa 1 frame a cada N frames do vídeo.\n"
"• 1: Analisa tudo (lento).\n"
"• 10: Pula 9 frames (rápido).\n"
"• Recomendado: 5 ou 10 conforme a velocidade do vídeo."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:380
msgid ""
"Display Interval (frames)\n"
"\n"
"How often the on-screen image refreshes during processing.\n"
"• Use high values (e.g. 30) to speed the analysis up by saving video resources."
msgstr ""
"Intervalo de Exibição (frames)\n"
"\n"
"Frequência de atualização da imagem na tela durante o processo.\n"
"• Use valores altos (ex: 30) para acelerar a análise economizando recursos de vídeo."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:391
msgid "AI Models"
msgstr "Modelos de IA"

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:405
msgid ""
"Model for Aquarium Detection\n"
"\n"
"• seg: segmentation (more precise at the corners).\n"
"• det: box detection (faster)."
msgstr ""
"Modelo para Detecção do Aquário\n"
"\n"
"• seg: Segmentação (mais preciso nos cantos).\n"
"• det: Detecção por caixa (mais rápido)."

#: src/zebtrack/ui/dialogs/single_video_config_dialog.py:426
msgid ""
"Model for Fish Tracking\n"
"\n"
"• seg: recommended for several fish (avoids confusion).\n"
"• det: recommended for 1 fish (very fast)."
msgstr ""
"Modelo para Rastreamento do Peixe\n"
"\n"
"• seg: Recomendado para múltiplos peixes (evita confusão).\n"
"• det: Recomendado para 1 peixe (muito rápido)."

