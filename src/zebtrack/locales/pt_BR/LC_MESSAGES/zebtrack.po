msgid "Live (record straight from the camera in real time)"
msgstr "Ao Vivo (gravar diretamente da câmera em tempo real)"

#: src/zebtrack/ui/wizard/discovery_step.py:193
msgid ""
"Record experiments in real time using a camera connected to the computer."
msgstr ""
"Gravar experimentos em tempo real usando câmera conectada ao computador."

#: src/zebtrack/ui/wizard/discovery_step.py:197
msgid "2. Folder Organization"
msgstr "2. Organização de Pastas"

#: src/zebtrack/ui/wizard/discovery_step.py:202
msgid "Yes - folders represent the experimental structure (e.g. Group/Day/)"
msgstr "Sim - pastas representam estrutura experimental (ex: Grupo/Dia/)"

#: src/zebtrack/ui/wizard/discovery_step.py:208
msgid ""
"The wizard will detect groups, days and subjects automatically from the "
"folder structure (e.g. /Control/Day01/Subject01.mp4)."
msgstr ""
"O assistente detectará automaticamente grupos, dias e sujeitos a partir da "
"estrutura de pastas (ex: /Control/Day01/Subject01.mp4)."

