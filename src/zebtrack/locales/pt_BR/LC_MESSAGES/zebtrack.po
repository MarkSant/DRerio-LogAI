# | msgid "Preparing video processing..."
#: src/zebtrack/ui/components/config_editor.py:177
#: src/zebtrack/ui/components/control_panel.py:96
#: src/zebtrack/ui/components/project_views/video_selector_tree_manager.py:599
msgid "Video Processing"
msgstr "Processamento de Vídeo"

#: src/zebtrack/ui/components/config_editor.py:188
msgid "Output FPS (MP4):"
msgstr "FPS de saída (MP4):"

#: src/zebtrack/ui/components/config_editor.py:194
msgid ""
"Output FPS (Frames Per Second)\n"
"\n"
"Sets the playback speed of the .mp4 produced by the analysis.\n"
"• Recommended: the same value as the original video (e.g. 30).\n"
"• Higher: the video looks sped up.\n"
"• Lower: the video looks like slow motion."
msgstr ""
"FPS de Saída (Frames Per Second)\n"
"\n"
"Define a velocidade de reprodução do vídeo .mp4 resultante da análise.\n"
"• Recomendado: O mesmo valor do vídeo original (ex: 30).\n"
"• Aumentar: O vídeo parecerá acelerado.\n"
"• Diminuir: O vídeo parecerá em câmera lenta."

#: src/zebtrack/ui/components/config_editor.py:206
msgid "Processing Interval (N):"
msgstr "Intervalo Processamento (N):"

#: src/zebtrack/ui/components/config_editor.py:212
msgid ""
"Processing Interval (Analysis)\n"
"\n"
"Processes 1 frame every N original frames.\n"
"• N=1: processes EVERY frame (maximum precision, slowest).\n"
"• N=10: processes 1 frame and skips 9 (faster, ideal for long videos).\n"
"• Higher: cuts processing time dramatically.\n"
"• Lower: improves the temporal resolution of speed metrics."
msgstr ""
"Intervalo de Processamento (Análise)\n"
"\n"
"Processa 1 frame a cada N frames originais.\n"
"• N=1: Processa TODOS os frames (máxima precisão, mais lento).\n"
"• N=10: Processa 1 frame e pula 9 (mais rápido, ideal para vídeos longos).\n"
"• Aumentar: Reduz drasticamente o tempo de processamento.\n"
"• Diminuir: Melhora a resolução temporal das métricas de velocidade."

#: src/zebtrack/ui/components/config_editor.py:225
msgid "Display Interval (N):"
msgstr "Intervalo Exibição (N):"

#: src/zebtrack/ui/components/config_editor.py:231
msgid ""
"Display Interval (UI)\n"
"\n"
"Refreshes the on-screen image every N processed frames.\n"
"• N=1: smooth display (uses more CPU/GPU).\n"
"• N=30: refreshes every 30 frames (lighter).\n"
"• Useful to speed the analysis up by saving visual resources."
msgstr ""
"Intervalo de Exibição (UI)\n"
"\n"
"Atualiza a imagem na tela a cada N frames processados.\n"
"• N=1: Exibição fluida (consome mais CPU/GPU).\n"
"• N=30: Atualiza a cada 30 frames (mais leve).\n"
"• Útil para acelerar a análise economizando recursos visuais."

#: src/zebtrack/ui/components/config_editor.py:243
msgid "Initial Offset (frames):"
msgstr "Offset Inicial (frames):"

#: src/zebtrack/ui/components/config_editor.py:249
msgid ""
"Initial Offset\n"
"\n"
"Number of leading frames to ignore before tracking starts.\n"
"• Use it to discard the water settling down or the experimenter's hand leaving the scene.\n"
"• E.g. in a 30fps video, an offset of 90 frames skips the first 3 seconds."
msgstr ""
"Offset Inicial\n"
"\n"
"Número de frames iniciais a serem ignorados antes de começar o rastreamento.\n"
"• Use para descartar o período de estabilização da água ou a mão do experimentador saindo de cena.\n"
"• Ex: Em um vídeo de 30fps, um offset de 90 frames ignora os primeiros 3 segundos."

#: src/zebtrack/ui/components/config_editor.py:266
msgid "Trajectory Smoothing (Savitzky-Golay Filter)"
msgstr "Suavização de Trajetória (Filtro Savitzky-Golay)"

#: src/zebtrack/ui/components/config_editor.py:277
msgid "Smoothing Window:"
msgstr "Janela de Suavização:"

#: src/zebtrack/ui/components/config_editor.py:283
msgid ""
"Smoothing Window (Window Length)\n"
"\n"
"Number of frames used to smooth the trajectory. MUST BE ODD.\n"
"• Higher (e.g. 11, 15): removes more noise/jitter, but may round the curves off too much.\n"
"• Lower (e.g. 3, 5): keeps more detail of abrupt movements.\n"
"• Default: 7"
msgstr ""
"Janela de Suavização (Window Length)\n"
"\n"
"Número de frames usados para suavizar a trajetória. DEVE SER ÍMPAR.\n"
"• Aumentar (ex: 11, 15): Remove mais ruído/tremido, mas pode 'arredondar' demais as curvas.\n"
"• Diminuir (ex: 3, 5): Mantém mais detalhes dos movimentos bruscos.\n"
"• Padrão: 7"

#: src/zebtrack/ui/components/config_editor.py:296
msgid "Polynomial Order:"
msgstr "Ordem do Polinômio:"

#: src/zebtrack/ui/components/config_editor.py:302
msgid ""
"Polynomial Order (Polyorder)\n"
"\n"
"Complexity of the curve fitted through the points. Must be SMALLER than the window.\n"
"• 1: straight line (aggressive smoothing).\n"
"• 2: simple curve (parabola).\n"
"• 3: more complex curve (recommended).\n"
"• Higher: the curve follows the original points more closely.\n"
"• Default: 3"
msgstr ""
"Ordem do Polinômio (Polyorder)\n"
"\n"
"Complexidade da curva usada para ajustar os pontos. Deve ser MENOR que a janela.\n"
"• 1: Linha reta (suavização agressiva).\n"
"• 2: Curva simples (parábola).\n"
"• 3: Curva mais complexa (recomendado).\n"
"• Aumentar: A curva segue mais de perto os pontos originais.\n"
"• Padrão: 3"

#: src/zebtrack/ui/components/config_editor.py:320
msgid ""
"ℹ️ This filter removes small detection jitter without losing the real track."
" Useful for more accurate distance and speed metrics."
msgstr ""
"ℹ️ Este filtro remove tremidos pequenos da detecção sem perder o rastro "
"real. Útil para métricas de distância e velocidade mais precisas."

#: src/zebtrack/ui/components/config_editor.py:334
msgid "Data Recording (Recorder)"
msgstr "Gravação de Dados (Recorder)"

#: src/zebtrack/ui/components/config_editor.py:345
msgid "Automatic Flush (s):"
msgstr "Flush Automático (s):"

#: src/zebtrack/ui/components/config_editor.py:351
msgid ""
"Flush Interval (Time)\n"
"\n"
"Every X seconds the system forces the in-memory data out to the Parquet file.\n"
"• Protects against data loss if the app crashes.\n"
"• Low values (e.g. 1.0) increase disk usage.\n"
"• Default: 5.0s"
msgstr ""
"Intervalo de Flush (Tempo)\n"
"\n"
"A cada X segundos, o sistema força a gravação dos dados da memória para o arquivo Parquet.\n"
"• Protege contra perda de dados se o app cair.\n"
"• Valores baixos (ex: 1.0) aumentam o uso de disco.\n"
"• Padrão: 5.0s"

#: src/zebtrack/ui/components/config_editor.py:364
msgid "Row Limit (Flush):"
msgstr "Limite de Linhas (Flush):"

#: src/zebtrack/ui/components/config_editor.py:370
msgid ""
"Row Limit for Flush\n"
"\n"
"Writes data out as soon as X rows are held in memory.\n"
"• Default: 500 rows."
msgstr ""
"Limite de Linhas para Flush\n"
"\n"
"Grava dados imediatamente ao atingir X linhas em memória.\n"
"• Padrão: 500 linhas."

# | msgid "🐟 Animal (Segmentation)"
#: src/zebtrack/ui/components/config_editor.py:380
msgid "Save Masks (Segmentation):"
msgstr "Salvar Máscaras (Segmentação):"

#: src/zebtrack/ui/components/config_editor.py:386
msgid ""
"Save Segmentation Masks\n"
"\n"
"Writes the 3b_Mascaras_<video>.parquet sidecar with the mask of every detection.\n"
"• It is the ONLY source of masks for the 'seg_overlap' ROI rule.\n"
"• Cost: an extra file on disk and mask decoding during tracking. Turned off it costs nothing.\n"
"\n"
"Turning this key on alone does NOT enable 'seg_overlap'. The three prerequisites must hold together:\n"
"  1. recorder.persist_masks (this option)\n"
"  2. model_selection.animal_method = 'seg' (segmentation model)\n"
"  3. the 'seg_overlap' ROI rule selected\n"
"If any is missing the analysis falls back to 'bbox_intersects' and records the warning in the report.\n"
"• Default: off."
msgstr ""
"Salvar Máscaras de Segmentação\n"
"\n"
"Grava o sidecar 3b_Mascaras_<video>.parquet com a máscara de cada detecção.\n"
"• É a ÚNICA fonte de máscaras da regra de ROI 'seg_overlap'.\n"
"• Custo: arquivo extra em disco e decodificação da máscara durante o rastreamento. Desligado não custa nada.\n"
"\n"
"Ligar só esta chave NÃO habilita 'seg_overlap'. Os três pré-requisitos precisam valer juntos:\n"
"  1. recorder.persist_masks (esta opção)\n"
"  2. model_selection.animal_method = 'seg' (modelo de segmentação)\n"
"  3. a regra de ROI 'seg_overlap' selecionada\n"
"Faltando qualquer um, a análise cai para 'bbox_intersects' e registra o aviso no relatório.\n"
"• Padrão: desligado."

#: src/zebtrack/ui/components/config_editor.py:405
msgid "Required for the 'seg_overlap' ROI rule"
msgstr "Necessário para a regra de ROI 'seg_overlap'"

#: src/zebtrack/ui/components/config_editor.py:413
msgid "ROI Inclusion Logic (Default)"
msgstr "Lógica de Inclusão em ROI (Padrão)"

#: src/zebtrack/ui/components/config_editor.py:424
msgid "Inclusion Rule:"
msgstr "Regra de Inclusão:"

#: src/zebtrack/ui/components/config_editor.py:430
msgid ""
"ROI Inclusion Logic\n"
"\n"
"Defines when the fish counts as 'inside' a zone.\n"
"• Centroid (centroid_in): only if the centre point is in the zone.\n"
"• Centroid w/ Buffer: expands the zone virtually for the calculation.\n"
"• BBox Intersection: if any part of the fish's box touches the zone.\n"
"• Seg Overlap: based on the pixel mask (most accurate).\n"
"\n"
"'seg_overlap' needs two more things besides this rule: recorder.persist_masks enabled (the 'Save Masks' option above) and model_selection.animal_method = 'seg'. If either is missing the analysis degrades to 'bbox_intersects' and warns in the report."
msgstr ""
"Lógica de Inclusão em ROI\n"
"\n"
"Define quando o peixe é considerado 'dentro' de uma zona.\n"
"• Centroide (centroid_in): Apenas se o ponto central estiver na zona.\n"
"• Centroide c/ Buffer: Expande a zona virtualmente para o cálculo.\n"
"• Intersecção BBox: Se qualquer parte da caixa do peixe tocar a zona.\n"
"• Sobreposição Seg: Baseado na máscara de pixels (mais preciso).\n"
"\n"
"'seg_overlap' exige mais duas coisas além desta regra: recorder.persist_masks ligado (opção 'Salvar Máscaras' acima) e model_selection.animal_method = 'seg'. Faltando qualquer uma, a análise degrada para 'bbox_intersects' e avisa no relatório."

#: src/zebtrack/ui/components/config_editor.py:460
msgid "Buffer Radius (r):"
msgstr "Raio de Buffer (r):"

#: src/zebtrack/ui/components/config_editor.py:466
msgid ""
"Buffer Radius\n"
"\n"
"Extra distance the ROI is expanded by in the 'Centroid w/ Buffer' rule.\n"
"• Unit: centimetres (if calibrated) or pixels."
msgstr ""
"Raio de Buffer\n"
"\n"
"Distância extra para expansão da ROI na regra 'Centroide c/ Buffer'.\n"
"• Unidade: Centímetros (se calibrado) ou Pixels."

#: src/zebtrack/ui/components/config_editor.py:477
msgid "Minimum Overlap:"
msgstr "Sobreposição Mínima:"

#: src/zebtrack/ui/components/config_editor.py:483
msgid ""
"Minimum Overlap Fraction\n"
"\n"
"Minimum area (0 to 1) that must be inside the zone to count.\n"
"• E.g. 0.50 means half of the reference area inside the zone.\n"
"• 0 (only in the 'BBox Intersection' rule): any real overlap counts; merely touching the border does not."
msgstr ""
"Fração de Sobreposição Mínima\n"
"\n"
"Mínimo de área (0 a 1) que deve estar na zona para contar.\n"
"• Ex: 0.50 significa metade da área de referência dentro da zona.\n"
"• 0 (só na regra 'Intersecção BBox'): qualquer sobreposição real conta; encostar na borda não."

#: src/zebtrack/ui/components/config_editor.py:495
msgid "Overlap Basis:"
msgstr "Base da Sobreposição:"

#: src/zebtrack/ui/components/config_editor.py:501
msgid ""
"Basis (denominator) of the Overlap Fraction\n"
"\n"
"Defines WHAT the fraction is measured against.\n"
"• bbox: fraction of the fish's box that is in the zone (historical).\n"
"• roi: fraction of the zone that is covered by the box.\n"
"• max: the larger of the two — recommended for small zones, where 'bbox' underestimates (a box 4x bigger than the zone, covering it entirely, scores only 0.25)."
msgstr ""
"Base (denominador) da Fração de Sobreposição\n"
"\n"
"Define em relação a QUE a fração é medida.\n"
"• bbox: fração da caixa do peixe que está na zona (histórico).\n"
"• roi: fração da zona que está coberta pela caixa.\n"
"• max: o maior dos dois — recomendado para zonas pequenas, onde 'bbox' subestima (uma caixa 4x maior que a zona, cobrindo-a inteira, marca só 0.25)."

