# Normalize all text files to LF on check-in
* text=auto eol=lf

# Explicitly set line endings for common text files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Binary files (should not be normalized)
*.pt binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.lnk binary
*.parquet binary

# Compiled gettext catalogues. These ship inside the package and are read at
# runtime; line-ending normalization would corrupt them, and the damage only
# shows up as untranslated strings rather than as an error.
*.mo binary

# .po/.pot are text, but keep them LF so a Windows checkout does not rewrite
# every line of a catalogue on the next `pybabel update`.
*.po text eol=lf
*.pot text eol=lf
